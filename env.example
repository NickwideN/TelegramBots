# --- Общие настройки (все боты) ---
# polling (локально) | webhook (Google Cloud Run)
BOT_MODE=polling

# sqlite (локально) | postgres (Cloud Run + Cloud SQL)
DB_BACKEND=sqlite
# SQLITE_PATH=data/telegram_bots.db
# DATABASE_URL=postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# Webhook (только при BOT_MODE=webhook)
# WEBHOOK_URL=https://your-service-xxxxx.run.app
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=случайная_строка
# PORT=8080
# WEBHOOK_HOST=0.0.0.0

# --- wish_bot ---
WISH_BOT_ENABLED=1
WISH_BOT_TOKEN=
