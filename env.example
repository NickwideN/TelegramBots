# Включение ботов (1 / true / yes — включён)
WISH_BOT_ENABLED=1

# Токены (@BotFather)
WISH_BOT_TOKEN=

# Хранилище: sqlite (локально) | memory (тесты) | postgres (Heroku)
WISH_BOT_STORAGE=sqlite

# Путь к SQLite (по умолчанию bots/wish_bot/data/wish_bot.db)
# WISH_BOT_SQLITE_PATH=bots/wish_bot/data/wish_bot.db

# Postgres (Heroku подставляет DATABASE_URL автоматически)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
