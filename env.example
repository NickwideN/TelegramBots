# --- Общее ---
WISH_BOT_ENABLED=1
WISH_BOT_TOKEN=

# polling (локально) | webhook (Google Cloud Run)
BOT_MODE=polling

# --- Локальная разработка (BOT_MODE=polling) ---
WISH_BOT_STORAGE=sqlite
# WISH_BOT_SQLITE_PATH=bots/wish_bot/data/wish_bot.db

# --- Google Cloud Run (BOT_MODE=webhook) ---
# WEBHOOK_URL=https://your-service-xxxxx.run.app
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=случайная_строка
# PORT=8080
# WEBHOOK_HOST=0.0.0.0

# WISH_BOT_STORAGE=postgres
# DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
