# --- Общие настройки (все боты) ---
BOT_MODE=polling
DB_BACKEND=sqlite

# SQLite (локально)
# SQLITE_PATH=data/telegram_bots.db

# Postgres — вариант A: одна строка (Cloud Run)
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@/wish_bot?host=/cloudsql/PROJECT:REGION:INSTANCE

# Postgres — вариант B: по частям (удобно в Cloud Run Secrets)
# CLOUD_SQL_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# POSTGRES_USER=wish-bot
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=wish_bot

# Webhook (BOT_MODE=webhook)
# WEBHOOK_URL=https://your-service-xxxxx.run.app
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=случайная_строка
# PORT=8080
# WEBHOOK_HOST=0.0.0.0

# --- wish_bot ---
WISH_BOT_ENABLED=1
WISH_BOT_TOKEN=

# Telegram ID тестировщиков через запятую (команда /delete_db, не в /help)
# WISH_BOT_TESTER_IDS=123456789,987654321

# Справочники для Google Cloud (не читаются приложением, только для копирования):
#   .env.dev  — переменные dev-сервиса
#   .env.prod — переменные prod-сервиса
